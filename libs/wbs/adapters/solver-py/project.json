{
  "name": "wbs-solver-py",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/wbs/adapters/solver-py/src",
  "projectType": "library",
  "tags": ["scope:lib", "type:lib", "runtime:python", "ring:adapter", "product:wbs"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m unittest discover -s tests -t tests",
        "cwd": "libs/wbs/adapters/solver-py"
      },
      "cache": false
    },
    "setup-local-solver": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/dev/solver-setup-cli.ts"
      },
      "cache": false
    }
  }
}
