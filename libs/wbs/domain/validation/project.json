{
  "name": "wbs-validation",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/wbs/domain/validation/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:validation", "runtime:isomorphic", "ring:domain", "product:wbs"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/domain/validation/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/domain/validation/src --cache --cache-location .nx/eslintcache-wbs-validation"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov",
        "cwd": "libs/wbs/domain/validation"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov",
        "cwd": "libs/wbs/domain/validation"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/wbs/domain/validation/tsconfig.json"
      }
    }
  }
}
