{
  "name": "wbs-conformance",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/wbs/application/conformance/src",
  "projectType": "library",
  "tags": ["scope:shared", "ring:application", "runtime:bun", "product:wbs"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx eslint libs/wbs/application/conformance/src" }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/application/conformance/src --cache --cache-location .nx/eslintcache-wbs-conformance"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov",
        "cwd": "libs/wbs/application/conformance"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov",
        "cwd": "libs/wbs/application/conformance"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/wbs/application/conformance/tsconfig.json"
      }
    }
  }
}
