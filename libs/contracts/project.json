{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/contracts/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:contracts", "runtime:isomorphic", "ring:domain"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/contracts/src libs/contracts/solver/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/contracts/src libs/contracts/solver/src --cache --cache-location .nx/eslintcache-contracts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find src solver/src -name '*.test.ts' -o -name '*.test.tsx' | sort) --coverage --coverage-reporter=lcov",
        "cwd": "libs/contracts"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find src solver/src -name '*.test.ts' -o -name '*.test.tsx' | sort) --coverage --coverage-reporter=lcov",
        "cwd": "libs/contracts"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/contracts/tsconfig.json"
      }
    }
  }
}
