{
  "name": "config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/config/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:config", "runtime:bun"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/config/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov",
        "cwd": "libs/config"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --noEmit -p libs/config/tsconfig.json"
      }
    }
  }
}
