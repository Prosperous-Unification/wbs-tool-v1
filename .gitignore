node_modules/
# Without this second line the trailing slash above matches a directory only,
# so a `node_modules` SYMLINK is untracked-but-addable and `git add -A` commits it.
node_modules
dist/
coverage/
.nx/cache
# ESLint caches written by the `lint:fast` targets. Never by `lint`: the gate
# and CI must not trust a cache, because a type change in one project can stale
# another's `no-unsafe-*` verdict.
.nx/eslintcache-*
.nx/workspace-data
*.tsbuildinfo
routeTree.gen.ts

package-lock.json
yarn.lock
pnpm-lock.yaml

.env
.env.local
!.env.example
!*.env.sops

~/.config/sops/age/keys.txt
*.age

.DS_Store
.idea/

vite.config.*.timestamp*
# And vitest's, which the line above does not match: the file is
# `vitest.config.ts.timestamp-…mjs`, and `vite.config.*` stops at the `s`.
# Written by every `vitest run` that loads a TS config and deleted seconds
# later, so it is only ever visible to whatever looks at the tree in that
# window — a `git add -A` mid-run being the one that matters.
vitest.config.*.timestamp*

# Complete output retained by the CI Nx gate before its bounded runner tail.
nx-gate.log

# What the browser layout gate leaves behind: the screenshot CI uploads, the
# traces, and the HTML report. Diagnostics of one run, never of the repo.
test-results/
test-results-packaged/
playwright-report/
.claude/worktrees
# `.nxignore` codifies `.worktrees/<name>` as the convention for agent lanes, and
# a nested worktree is untracked. `bin/h2puni-gate.sh` refuses a tree that is
# dirty after its checkout (exit 65), so without this line one lane following
# that convention makes every gate in the shared h2puni tree refuse.
.worktrees/
.nx/polygraph
.nx/self-healing

# Local dev SQLite databases (per-developer scratch state)
*.db
*.db-journal
*.db-wal
*.db-shm
# SDD scratch workspace (ledger, briefs, review packages)
.superpowers/

# Reviewer transcripts and one-off prompts. Ephemeral by design: the codex
# transcript for one review ran to 4,460 lines of tool traffic, and it was
# staged for commit once before anyone noticed. Findings worth keeping go in
# the change's verify.md.
tmp/

# CPython bytecode from libs/solver-py's suite. The gate runs
# `python -m unittest` inside the checkout, so a `git status --porcelain | wc -l`
# cleanliness assertion after a gate run counts two untracked directories and
# reads as a dirty tree — which is how a worker learns to ignore that check.
__pycache__/
*.py[cod]

.nx/migrate-runs
# Secret backups. `configure.sh` and hand-edits leave these beside the real
# `.env`; they are as sensitive as the file they copy and must never be staged.
**/.env.bak-*

# The macOS development solver environment (tools/dev/solver-environment.ts)
# and the setuptools artifacts its install leaves behind.
.venv-solver/
libs/solver-py/build/
libs/solver-py/src/*.egg-info/
