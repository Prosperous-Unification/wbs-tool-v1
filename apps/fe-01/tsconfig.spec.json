{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@wbs/domain/workday": ["../../libs/domain/src/workday.ts"],
      "@wbs/domain/effective-set": ["../../libs/domain/src/effective-set.ts"]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "vitest.setup.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vite-config.test.ts"
  ]
}
