{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@wbs/domain/workday": ["../../libs/domain/src/workday.ts"],
      "@wbs/domain/assumed-duration": ["../../libs/domain/src/assumed-duration.ts"],
      "@wbs/domain/effective-team": ["../../libs/domain/src/effective-team.ts"],
      "@wbs/domain/effective-tag": ["../../libs/domain/src/effective-tag.ts"],
      "@wbs/domain/effective-service": ["../../libs/domain/src/effective-service.ts"],
      "@wbs/domain/label-mismatch": ["../../libs/domain/src/label-mismatch.ts"],
      "@wbs/domain/marker-color": ["../../libs/domain/src/marker-color.ts"],
      "@wbs/contracts/ws-frames": ["../../libs/contracts/src/ws-frames.ts"],
      "@wbs/domain/is-within": ["../../libs/domain/src/is-within.ts"],
      "@wbs/domain/priority-band": ["../../libs/domain/src/priority-band.ts"],
      "@wbs/domain/dependency-reach": ["../../libs/domain/src/dependency-reach.ts"],
      "@wbs/domain/external-system": ["../../libs/domain/src/external-system.ts"]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "vitest.setup.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.node.config.ts",
    "vitest.zoned.config.ts",
    "vitest.node-suites.ts",
    "vite-config.test.ts",
    "playwright.config.ts",
    "playwright-config.test.ts"
  ]
}
