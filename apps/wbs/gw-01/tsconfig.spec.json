{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "types": ["bun-types"],
    // No DOM. gw-01's tests run in Bun, and with the DOM lib in scope the DOM's
    // `WebSocket` shadows Bun's (bun-types' `UseLibDomIfAvailable`) — so the
    // `headers` these tests open a socket with is not a known property of the
    // second argument. Seven such calls were type errors no `typecheck` target
    // compiled until 2026-09-02.
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
