{
  "name": "wbs-be-01",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wbs/be-01/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun", "ring:adapter", "product:wbs"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch src/main.ts",
        "cwd": "apps/wbs/be-01"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun build apps/wbs/be-01/src/main.ts --target=bun --outdir=dist/apps/wbs/be-01",
          "bun apps/wbs/be-01/src/openapi/emit-openapi-cli.ts dist/apps/wbs/be-01/openapi.json"
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/apps/wbs/be-01"]
    },
    "solver-image-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "shellcheck -s bash apps/wbs/be-01/scripts/solver-image-smoke.sh && bash apps/wbs/be-01/scripts/solver-image-smoke.sh"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/wbs/be-01/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/wbs/be-01/src --cache --cache-location .nx/eslintcache-wbs-be-01"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/libs/wbs/domain/domain/src/schedule.ts",
        "{workspaceRoot}/openspec/changes/dual-optimized-scheduler/design.md",
        "{workspaceRoot}/tools/tool-remote-scripts/src/fixtures/solver-supervisor-orphan-host.ts"
      ],
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov",
        "cwd": "apps/wbs/be-01"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find src -name '*.test.ts' ! -name '*.db.test.ts' | tr '\\n' ' ')",
        "cwd": "apps/wbs/be-01"
      }
    },
    "test:store": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test .db.test.ts",
        "cwd": "apps/wbs/be-01"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/wbs/be-01/tsconfig.json"
      }
    },
    "serve-local-solver": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch src/dev/main.ts",
        "cwd": "apps/wbs/be-01"
      },
      "cache": false
    }
  }
}
