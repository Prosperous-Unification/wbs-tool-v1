{
  "name": "be-01",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/be-01/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch src/main.ts",
        "cwd": "apps/be-01"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun build apps/be-01/src/main.ts --target=bun --outdir=dist/apps/be-01"
      },
      "outputs": ["{workspaceRoot}/dist/apps/be-01"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/be-01/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/be-01/src --cache --cache-location .nx/eslintcache-be-01"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production", "{workspaceRoot}/libs/domain/src/schedule.ts"],
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov",
        "cwd": "apps/be-01"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find src -name '*.test.ts' ! -name '*.db.test.ts' | tr '\\n' ' ')",
        "cwd": "apps/be-01"
      }
    },
    "test:store": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test .db.test.ts",
        "cwd": "apps/be-01"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/be-01/tsconfig.json"
      }
    }
  }
}
