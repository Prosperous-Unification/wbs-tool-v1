#!/bin/sh
# prepare-commit-msg — stamp `Agent-Authored-By:` on commits an agent makes.
#
# TASK-389. Agents on this fleet push with the owner's credentials, so an agent
# commit and a hand-written one are indistinguishable to anything reading
# GitHub. This makes them distinguishable without a second identity and without
# changing who the commit belongs to: the author stays whoever git says it is,
# and a trailer records that an agent process produced it.
#
# A trailer rather than an identity because GitHub squash-merges rewrite author
# and committer to the merging account, but preserve the message body.
# See notes/agent-attribution-2026-09-08.md.
#
# Installed through this repository's `lefthook.yml`, which preserves the
# existing lefthook wrapper while invoking this script at both message stages.
#
# agent-trailer-hook-v1 — the installer's ownership signature. A hook carrying
# this exact line is a copy of this file and may be replaced by a newer one;
# anything else is somebody else's hook and is refused.
#
# This hook must never fail a commit. Every failure path falls through to a
# clean exit, because a broken measurement is not worth a blocked commit.

set -u

msg_file="${1:-}"
msg_source="${2:-}"
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

# `merge` and `squash` messages are generated by git, not by whoever is
# committing, so stamping them would attribute the merge rather than the work.
case "$msg_source" in
	merge|squash) exit 0 ;;
esac

# Explicit override first, so a wrapper can name the exact model.
#
# Everything below it must be a marker the *running agent process* sets, never a
# credential or a configuration directory (peer review round 2, Important 2). A
# human who exports `GEMINI_API_KEY` or `CODEX_HOME` in their shell profile still
# commits by hand, and stamping them inflates the number this trailer exists to
# measure. `CLAUDECODE`, `CODEX_SANDBOX` and `GEMINI_CLI` are set by the CLI for
# the duration of its own process; API keys and home directories are not.
label="${AGENT_AUTHORED_BY:-}"
if [ -z "$label" ]; then
	if [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
		label="claude-code"
	elif [ -n "${CODEX_SANDBOX:-}" ]; then
		label="codex"
	elif [ -n "${GEMINI_CLI:-}" ]; then
		label="gemini-cli"
	elif [ -n "${OPENCLAW_SERVICE_KIND:-}" ]; then
		label="openclaw"
	fi
fi

# No agent marker means a human is committing. Say nothing: a false positive
# here is worse than a missing data point, because it inflates the very number
# the trailer exists to measure.
[ -n "$label" ] || exit 0

# Idempotent: a `--amend` or a re-run must not stack a second trailer.
if grep -qi '^Agent-Authored-By:' "$msg_file"; then
	exit 0
fi

# `git interpret-trailers` puts the line in the real trailer block, after the
# body and before any comment lines git appends to the editor template.
if git interpret-trailers --in-place --trailer "Agent-Authored-By: $label" "$msg_file" 2>/dev/null; then
	exit 0
fi

# Fallback for a git too old for --in-place: append and accept the cruder
# placement rather than losing the signal.
printf '\nAgent-Authored-By: %s\n' "$label" >>"$msg_file" 2>/dev/null || true
exit 0
