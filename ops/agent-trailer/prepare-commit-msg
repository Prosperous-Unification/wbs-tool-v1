#!/bin/sh
# prepare-commit-msg — stamp `Agent-Authored-By:` on commits an agent makes.
#
# TASK-389. Agents on this fleet push with the owner's credentials, so an agent
# commit and a hand-written one are indistinguishable to anything reading
# GitHub. This makes them distinguishable without a second identity and without
# changing who the commit belongs to: the author stays whoever git says it is,
# and a trailer records that an agent process produced it.
#
# A trailer rather than an identity because GitHub squash-merges rewrite author
# and committer to the merging account, but preserve the message body.
# See notes/agent-attribution-2026-09-08.md.
#
# Installed through this repository's `lefthook.yml`, which preserves the
# existing lefthook wrapper while invoking this script at both message stages.
#
# agent-trailer-hook-v1 — the hook's provenance signature. This repository's
# lefthook stages invoke the versioned source directly, so the line is a human-
# auditable fleet marker rather than permission to replace `.git/hooks` files.
#
# This hook must never fail a commit. Every failure path falls through to a
# clean exit, because a broken measurement is not worth a blocked commit.

set -u

msg_file="${1:-}"
msg_source="${2:-}"
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

# `merge` and `squash` messages are generated by git, not by whoever is
# committing, so stamping them would attribute the merge rather than the work.
case "$msg_source" in
	merge|squash) exit 0 ;;
esac

# `commit-msg` receives no source argument, so repeat the generated-message
# decision from repository state. MERGE_HEAD exists only while the merge is in
# progress. SQUASH_MSG can be left behind by an interrupted workflow, though,
# so its mere presence is not enough: only the message Git actually copied from
# that marker is generated. A later explicit message must still be attributed.
merge_head=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null) || merge_head=""
[ -n "$merge_head" ] && [ -f "$merge_head" ] && exit 0
squash_msg=$(git rev-parse --git-path SQUASH_MSG 2>/dev/null) || squash_msg=""
comment_prefix_auto=0
comment_string_supported=0
git_version=$(git version 2>/dev/null) || git_version=""
git_version=${git_version#git version }
git_major=${git_version%%.*}
git_version_tail=${git_version#*.}
git_minor=${git_version_tail%%.*}
case "$git_major:$git_minor" in
	*[!0-9:]*|:*|*:) ;;
	*) [ "$git_major" -gt 2 ] || { [ "$git_major" -eq 2 ] && [ "$git_minor" -ge 45 ]; } && comment_string_supported=1 ;;
esac
# Git 2.45+ makes both names feed the same setting, with the last occurrence
# winning. Older Git ignores commentString, so do the same on its fallback path.
comment_prefix=$(git config --get-regexp '^core\.comment(char|string)$' 2>/dev/null |
	awk -v allow_string="$comment_string_supported" '
		{ key = tolower($1); sub(/^[^ \t]+[ \t]*/, "") }
		key == "core.commentstring" && allow_string != 1 { next }
		{ selected = 1; value = $0 }
		END { if (selected) print value }
	') || comment_prefix=""
case "$comment_prefix" in
	"") comment_prefix="#" ;;
	auto) comment_prefix=""; comment_prefix_auto=1 ;;
esac
if [ -n "$squash_msg" ] && [ -f "$squash_msg" ]; then
	# prepare-commit-msg may append its editor template comments after copying
	# SQUASH_MSG, and verbose mode appends a diff below Git's scissors line.
	# Compare the effective messages above that line. If the committer edits the
	# squash text, that new message is authored and should be attributed.
	# Git prefixes this exact marker with core.commentString (Git 2.45+) or the
	# legacy one-byte core.commentChar. Match the complete line, tolerating the
	# CR in a CRLF message without treating a body substring as a boundary.
	message_body=$(awk '
		BEGIN { prefix = ARGV[1]; auto = ARGV[2]; ARGV[1] = ARGV[2] = "" }
		function is_scissors(line) {
			marker = " ------------------------ >8 ------------------------"
			return line == prefix marker || (auto == 1 && length(line) == length(marker) + 1 && substr(line, 2) == marker)
		}
		{ candidate = $0; sub(/\r$/, "", candidate) }
		is_scissors(candidate) { exit }
		{ print }
	' "$comment_prefix" "$comment_prefix_auto" "$msg_file" 2>/dev/null | git stripspace --strip-comments 2>/dev/null) || message_body=""
	squash_body=$(git stripspace --strip-comments <"$squash_msg" 2>/dev/null) || squash_body=""
	[ -n "$squash_body" ] && [ "$message_body" = "$squash_body" ] && exit 0
fi

# Explicit override first, so a wrapper can name the exact model.
#
# Everything below it must be a marker the *running agent process* sets, never a
# credential or a configuration directory (peer review round 2, Important 2). A
# human who exports `GEMINI_API_KEY` or `CODEX_HOME` in their shell profile still
# commits by hand, and stamping them inflates the number this trailer exists to
# measure. `CLAUDECODE`, `CODEX_SANDBOX` and `GEMINI_CLI` are set by the CLI for
# the duration of its own process; API keys and home directories are not.
# Reject an unsafe override as an override, not as the whole attribution
# attempt. A valid process marker below is still trustworthy and must be used.
label="${AGENT_AUTHORED_BY:-}"
case "$label" in
	*[!A-Za-z0-9._/-]*) label="" ;;
esac
[ "${#label}" -le 64 ] || label=""

if [ -z "$label" ]; then
	if [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
		label="claude-code"
	elif [ -n "${CODEX_SANDBOX:-}" ]; then
		label="codex"
	elif [ -n "${GEMINI_CLI:-}" ]; then
		label="gemini-cli"
	elif [ -n "${OPENCLAW_SERVICE_KIND:-}" ]; then
		label="openclaw"
	fi
fi

# One bounded trailer value, never another body/trailer line. Keep a final
# validation boundary even though detected labels are fixed constants.
case "$label" in
	*[!A-Za-z0-9._/-]*) exit 0 ;;
esac
[ "${#label}" -le 64 ] || exit 0

# No agent marker means a human is committing. Say nothing: a false positive
# here is worse than a missing data point, because it inflates the very number
# the trailer exists to measure.
[ -n "$label" ] || exit 0

# Idempotent: a `--amend` or a re-run must not stack a second trailer.
if grep -qi '^Agent-Authored-By:' "$msg_file"; then
	exit 0
fi

# `git interpret-trailers` puts the line in the real trailer block, after the
# body and before any comment lines git appends to the editor template.
if git interpret-trailers --in-place --trailer "Agent-Authored-By: $label" "$msg_file" 2>/dev/null; then
	exit 0
fi

# Fallback for a git too old for --in-place. A verbose message's tail is below
# Git's scissors marker and is discarded, so put the trailer immediately above
# that exact boundary; append only when no boundary exists.
fallback=$(mktemp "${msg_file}.agent-trailer.XXXXXX" 2>/dev/null) || {
	# `mktemp` is not universal on the old fleet this branch supports. Noclobber
	# gives its PID fallback the same no-overwrite property; if even that cannot
	# be created, preserve failure-open attribution with the soft append.
	fallback="${msg_file}.agent-trailer.$$"
	(set -C; : >"$fallback") 2>/dev/null || {
		printf '\nAgent-Authored-By: %s\n' "$label" >>"$msg_file" 2>/dev/null || true
		exit 0
	}
}
if awk -v trailer="Agent-Authored-By: $label" '
	BEGIN { prefix = ARGV[1]; auto = ARGV[2]; ARGV[1] = ARGV[2] = "" }
	function is_scissors(line) {
		marker = " ------------------------ >8 ------------------------"
		return line == prefix marker || (auto == 1 && length(line) == length(marker) + 1 && substr(line, 2) == marker)
	}
	function is_blank(line) { return line ~ /^[ \t]*$/ }
	function is_comment(line) {
		return (prefix != "" && index(line, prefix) == 1) ||
			(auto == 1 && length(line) > 0 && index("#;@!$%^&|:", substr(line, 1, 1)) != 0)
	}
	function is_trailer(line) { return line ~ /^[A-Za-z0-9][A-Za-z0-9-]*:[ \t]/ }
	function is_continuation(line) { return line ~ /^[ \t]+[^ \t]/ }
	function emit_before(boundary,   content_end, paragraph_start, paragraph_ok, prior_content, i) {
		content_end = boundary - 1
		while (content_end > 0 && (is_blank(clean[content_end]) || is_comment(clean[content_end]))) content_end--
		paragraph_start = content_end
		while (paragraph_start > 0 && !is_blank(clean[paragraph_start])) paragraph_start--
		paragraph_start++
		prior_content = 0
		for (i = 1; i < paragraph_start; i++) {
			if (!is_blank(clean[i]) && !is_comment(clean[i])) prior_content = 1
		}
		# A subject like `fix: text` is trailer-shaped. It is only a trailer
		# paragraph when a prior non-comment content paragraph precedes it.
		paragraph_ok = content_end >= paragraph_start && prior_content
		for (i = paragraph_start; i <= content_end && paragraph_ok; i++) {
			if (!is_trailer(clean[i]) && !(i > paragraph_start && is_continuation(clean[i]))) paragraph_ok = 0
		}
		for (i = 1; i <= content_end; i++) print lines[i]
		if (content_end > 0 && !paragraph_ok) print ""
		print trailer
		for (i = content_end + 1; i < boundary; i++) print lines[i]
	}
	{
		clean[NR] = $0
		if (clean[NR] ~ /\r$/) document_crlf = 1
		sub(/\r$/, "", clean[NR])
		lines[NR] = clean[NR]
		if (!boundary && is_scissors(clean[NR])) boundary = NR
	}
	END {
		ORS = document_crlf ? "\r\n" : "\n"
		if (!boundary) boundary = NR + 1
		emit_before(boundary)
		for (i = boundary; i <= NR; i++) print lines[i]
	}
' "$comment_prefix" "$comment_prefix_auto" "$msg_file" >"$fallback" 2>/dev/null && mv "$fallback" "$msg_file" 2>/dev/null; then
	:
else
	rm -f "$fallback" 2>/dev/null || true
fi
exit 0
