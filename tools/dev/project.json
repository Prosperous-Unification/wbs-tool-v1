{
  "name": "tool-dev-setup",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/dev",
  "projectType": "library",
  "tags": ["scope:infra", "type:scripts", "runtime:bun", "ring:adapter"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --preload ../test/scratch/preload.ts",
        "cwd": "tools/dev"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/dev"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/dev --cache --cache-location .nx/eslintcache-tool-dev-setup"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force tools/dev/tsconfig.json"
      }
    }
  }
}
