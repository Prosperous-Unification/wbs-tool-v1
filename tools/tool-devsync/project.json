{
  "name": "tool-devsync",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/tool-devsync/src",
  "projectType": "library",
  "tags": ["scope:infra", "type:scripts", "runtime:bun", "ring:adapter"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/bin/dev.sh",
        "{workspaceRoot}/bin/dev-be-probe.sh",
        "{workspaceRoot}/bin/dev-mcp-preflight.sh",
        "{workspaceRoot}/bin/dev-mcp-probe.sh",
        "{workspaceRoot}/bin/dev-poll.sh",
        "{workspaceRoot}/bin/dev-poll-sync.sh",
        "{workspaceRoot}/bin/dev-deploy.sh",
        "{workspaceRoot}/bin/h2puni-gate.sh",
        "{workspaceRoot}/deploy/dev-src/compose.yml",
        "{workspaceRoot}/apps/**/project.json",
        "{workspaceRoot}/libs/**/project.json",
        "{workspaceRoot}/tools/**/project.json",
        "{projectRoot}/workspace-projects.mjs",
        "{workspaceRoot}/apps/**/src/**/*.test.ts",
        "{workspaceRoot}/libs/**/src/**/*.test.ts",
        "{workspaceRoot}/tools/**/src/**/*.test.ts",
        "{workspaceRoot}/apps/**/src/**/*.ts",
        "{workspaceRoot}/apps/**/src/**/*.tsx",
        "{workspaceRoot}/libs/**/src/**/*.ts",
        "{workspaceRoot}/tools/**/src/**/*.ts",
        "{workspaceRoot}/.bun-version",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/apps/*/Dockerfile",
        "{workspaceRoot}/deploy/dev-src/Dockerfile"
      ],
      "options": {
        "command": "bun test --preload ../test/scratch/preload.ts",
        "cwd": "tools/tool-devsync"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-devsync/src tools/tool-devsync/workspace-projects.mjs"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-devsync/src tools/tool-devsync/workspace-projects.mjs --cache --cache-location .nx/eslintcache-tool-devsync"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force tools/tool-devsync/tsconfig.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/bin/dev-deploy.sh",
        "{workspaceRoot}/bin/dev.sh",
        "{workspaceRoot}/bin/dev-be-probe.sh",
        "{workspaceRoot}/bin/dev-mcp-preflight.sh",
        "{workspaceRoot}/bin/dev-mcp-probe.sh",
        "{workspaceRoot}/bin/dev-poll.sh",
        "{workspaceRoot}/bin/dev-poll-sync.sh"
      ],
      "options": {
        "commands": [
          "command -v shellcheck >/dev/null 2>&1 || { echo '[tool-devsync] shellcheck is required but not installed. macOS: brew install shellcheck. Debian/Ubuntu: apt-get install shellcheck.' >&2; exit 1; }",
          "shellcheck -s bash bin/dev.sh bin/dev-deploy.sh bin/dev-be-probe.sh bin/dev-mcp-preflight.sh bin/dev-mcp-probe.sh bin/dev-poll.sh bin/dev-poll-sync.sh"
        ],
        "parallel": false
      }
    }
  }
}
