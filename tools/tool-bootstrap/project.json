{
  "name": "tool-bootstrap",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/tool-bootstrap/src",
  "projectType": "library",
  "tags": ["scope:infra", "type:scripts", "runtime:bun", "ring:adapter"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "command -v shellcheck >/dev/null 2>&1 || { echo '[tool-bootstrap] shellcheck is required but not installed. macOS: brew install shellcheck. Debian/Ubuntu: apt-get install shellcheck.' >&2; exit 1; }",
          "shellcheck -s sh tools/tool-bootstrap/src/bootstrap.sh tools/tool-bootstrap/src/configure.sh"
        ],
        "parallel": false
      }
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/tool-bootstrap/src/push.ts"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/deploy/compose/Caddyfile.bootstrap",
        "{workspaceRoot}/deploy/compose/log-redact.caddy"
      ],
      "options": {
        "command": "bun test",
        "cwd": "tools/tool-bootstrap"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-bootstrap/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-bootstrap/src --cache --cache-location .nx/eslintcache-tool-bootstrap"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force tools/tool-bootstrap/tsconfig.json"
      }
    }
  }
}
