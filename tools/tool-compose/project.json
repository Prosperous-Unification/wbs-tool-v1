{
  "name": "tool-compose",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/tool-compose/src",
  "projectType": "library",
  "tags": ["scope:infra", "type:scripts", "runtime:bun", "ring:adapter"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/tool-compose/src/render.ts --outDir=dist/tools/tool-compose"
      },
      "outputs": ["{workspaceRoot}/dist/tools/tool-compose"]
    },
    "render": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/tool-compose/src/render.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production", "{workspaceRoot}/deploy/compose/**/*"],
      "options": {
        "command": "bun test --preload ../test/scratch/preload.ts",
        "cwd": "tools/tool-compose"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-compose/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-compose/src --cache --cache-location .nx/eslintcache-tool-compose"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force tools/tool-compose/tsconfig.json"
      }
    }
  }
}
