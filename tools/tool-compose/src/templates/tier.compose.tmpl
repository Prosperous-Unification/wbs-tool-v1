services:
  {{CONTAINER}}:
    image: {{IMAGE}}
    container_name: {{CONTAINER}}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: '20m'
        max-file: '3'
    networks:
      {{NETWORK}}:
        aliases:
          - {{CONTAINER}}
{{ENV_FILES}}{{VOLUMES}}
